# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL_POLICY=balanced   # free | cheap | balanced | quality | maximum

# Which provider core.models.factory.get_active_provider() returns.
# "anthropic" (default) | "openrouter"
# Switch to openrouter when you have no Anthropic credits available —
# nothing else in the codebase needs to change.
ACTIVE_PROVIDER=anthropic

# Only needed if ACTIVE_PROVIDER=openrouter. Get a free key at
# https://openrouter.ai/keys — no credit card required.
OPENROUTER_API_KEY=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

# Free-tier model OpenRouter routes to. Free model slugs rotate over time —
# if this stops working, check https://openrouter.ai/models (filter: Free)
# and paste a current one here. No code change needed either way.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional (Session 5): a fallback *logical* model name (e.g. cheap-fast) tried
# once if the primary model exhausts its retries on a transient error. Leave
# empty for no fallback. Only meaningfully different once a second provider or
# model is registered (see D007/D008).
MODEL_FALLBACK=

# Postgres connection string (Milestone C, Session 6+). Empty = no database
# configured (persistence calls then fail with a clear error). For local dev,
# start Postgres with `docker compose -f infra/docker-compose.yml up -d` and use
# the line below. In production, set this in the host's secret manager, not here.
DATABASE_URL=postgresql://engine:engine@localhost:5432/engine
